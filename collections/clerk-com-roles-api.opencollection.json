{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clerk Backend Account Portal Roles API",
    "version": "2025-11-10"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Organization Roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clerk.com/v1/v1/organizations/:organization_id/roles",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Applies a limit to the number of results returned.\nCan be used for paginating the results together with `offset`."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Skip the first `offset` results when paginating.\nNeeds to be an integer greater or equal to zero.\nTo be used in conjunction with `limit`."
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID."
              }
            ]
          },
          "docs": "Retrieve a list of all roles of an organization."
        }
      ]
    }
  ],
  "bundled": true
}
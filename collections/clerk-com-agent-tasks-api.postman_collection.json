          "name": "Create Agent Task",
          "request": {
            "name": "Create Agent Task",
            "description": {
              "content": "Create an agent task on behalf of a user.\nThe response contains a URL that, when visited, creates a session for the user.\nThe agent_id is stable per agent_name within an instance. The agent_task_id is unique per call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agents",
                "tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on_behalf_of\": {\n    \"user_id\": \"<string>\",\n    \"identifier\": \"<string>\"\n  },\n  \"permissions\": \"<string>\",\n  \"agent_name\": \"<string>\",\n  \"task_description\": \"<string>\",\n  \"redirect_url\": \"<uri>\",\n  \"session_max_duration_in_seconds\": 1800\n}",

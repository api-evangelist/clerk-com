            "name": "List Application Transfers",
            "description": {
              "content": "List all transfer requests created by the authenticated workspace. Returns\ntransfers sorted by creation date in descending order (most recent first).\n\nUse the `status` parameter to filter by transfer status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "platform",
                "application_transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],

          "name": "Create an Application Transfer",
          "request": {
            "name": "Create an Application Transfer",
            "description": {
              "content": "Create a new transfer request for an application. This initiates the process of\ntransferring ownership of the application to another workspace.\n\nOnly one pending transfer can exist for an application at a time. The transfer\nwill expire after 24 hours if not completed.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "platform",
                "applications",
                ":applicationID",
                "transfers"
              ],

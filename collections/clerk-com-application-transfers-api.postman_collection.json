                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by transfer status. Multiple values can be provided by repeating\nthe parameter (e.g., `?status=pending&status=canceled`).\n"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",

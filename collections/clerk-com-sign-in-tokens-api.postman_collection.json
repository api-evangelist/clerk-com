  "item": [
    {
      "id": "2619a3a6-3921-4425-85e6-5ec22f06fff4",
      "name": "Sign-in Tokens",
      "description": {
        "content": "Sign-in tokens are JWTs that can be used to sign in to an application without specifying any credentials.\nA sign-in token can be used at most once and they can be consumed from the Frontend API using the `ticket` strategy.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9377ef33-a094-4b6a-b1ea-d8ba5a3782e0",
          "name": "Create Sign-in Token",
          "request": {
            "name": "Create Sign-in Token",
            "description": {
              "content": "Creates a new sign-in token and associates it with the given user.\nBy default, sign-in tokens expire in 30 days.\nYou can optionally supply a different duration in seconds using the `expires_in_seconds` property.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sign_in_tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"<string>\",\n  \"expires_in_seconds\": 2592000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },

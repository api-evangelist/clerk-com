{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clerk Backend Account Portal Redirect API",
    "version": "2025-11-10"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Redirect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Redirect to a Validated URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clerk.com/v1/v1/redirect",
            "params": [
              {
                "name": "redirect_url",
                "value": "",
                "type": "query",
                "description": "The URL to redirect to (optional). If empty or not provided, redirects to the default URL."
              }
            ]
          },
          "docs": "Validates and redirects to a safe URL. If no URL is provided, redirects to a default URL."
        }
      ]
    }
  ],
  "bundled": true
}
      "item": [
        {
          "id": "f77b2e7d-026f-49ce-aa42-28cf591bd6b1",
          "name": "Create Actor Token",
          "request": {
            "name": "Create Actor Token",
            "description": {
              "content": "Create an actor token that can be used to impersonate the given user.\nThe `actor` parameter needs to include at least a \"sub\" key whose value is the ID of the actor (impersonating) user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actor_tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"<string>\",\n  \"actor\": {\n    \"sub\": \"<string>\"\n  },\n  \"expires_in_seconds\": 3600,\n  \"session_max_duration_in_seconds\": 1800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
